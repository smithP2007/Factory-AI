# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- Project: ML / Detection artifacts ---
# Keep the small demo model (yolo26n.pt ~5 MB) so the project is restartable.
# Exclude future large checkpoints / training-run outputs.
models/runs/
models/*.pth
models/*_last.pt
models/*_best.pt
!models/yolo26n.pt

# Keep demo datasets (small, ~10 MB total). Future large datasets like
# D-Fire (~1 GB) or Hard Hat Workers v2 (~500 MB) should be excluded
# manually when added (or use Git LFS).
datasets/raw/**/*.zip
datasets/raw/**/*.tar
datasets/raw/**/*.tar.gz

# --- Production (reacquired) datasets: data NOT committed, docs ARE ---
# D-Fire ~3.1 GB and Hard Hats ~1.2 GB exceed plain-git scale (see
# .gitignore note above). Reports, provenance, configs and QA JSONs
# under datasets/production/ remain tracked.
datasets/production/dfire/train/
datasets/production/dfire/test/
datasets/production/hardhats/train/
datasets/production/hardhats/valid/
datasets/production/hardhats/test/

# Ultralytics regenerates runs/ on every inference - exclude
runs/

# --- Ultralytics config (machine-local) ---
*.config
settings.json

# --- Logs / profiles ---
*.log
logs/
pip-log.txt
.profile_data/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# Hash caches (derived, regenerable by scripts/leakage_aware_split.py)
datasets/production/**/*.npz
# COCO person reference: images/labels are data, not tracked
datasets/production/coco_person_reference/images/
datasets/production/coco_person_reference/labels/
datasets/production/coco_person_reference/val2017/
datasets/production/construction_safety/train/
datasets/production/construction_safety/valid/
datasets/production/construction_safety/test/
datasets/production/construction_safety/_zips/
datasets/production/coco_person_reference/instances_val2017.json

# --- Credentials / secrets (NEVER commit) ---
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
credentials*.json
kaggle.json
kaggle_token*
*.token
.git-credentials
.htpasswd

